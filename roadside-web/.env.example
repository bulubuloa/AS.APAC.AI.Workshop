# Copy to .env - never commit .env
RSA_BASE_URL=https://roadside-uat.aspireasia.net
RSA_USER=
RSA_PASSWORD=
# A job that exists on UAT and is safe to read (job detail / job track specs)
RSA_TEST_JOB_ID=26JB048514
# clientId used in list filters (380 = Honda on UAT)
RSA_TEST_CLIENT_ID=380
# Program (by name) used for job creation - must have a privilege on the target env
RSA_TEST_PROGRAM=HOT UAT Program
